{
  "name": "earned",
  "version": "1.0.0",
  "description": "Personal fitness & nutrition tracker",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test tests/*.test.js",
    "build": "node scripts/write-build-info.js && cd client && npm install --include=dev && npm run build",
    "install:all": "npm install && cd client && npm install --include=dev",
    "verify": "node scripts/verify.js",
    "build:info": "node scripts/write-build-info.js"
  },
  "dependencies": {
    "better-sqlite3": "^9.4.3",
    "cors": "^2.8.5",
    "express": "^4.18.3",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  }
}
